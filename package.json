{
  "name": "endless-driving",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:drivetrain": "node tests/drivetrain-regression.mjs",
    "test:nyc-geo": "node tests/nyc-geo-regression.mjs",
    "test:world": "npm run test:nyc-geo && npm run test:city-urban && npm run test:city-routing && npm run test:nyc-road-data",
    "test:city-routing": "node tests/city-routing-regression.mjs",
    "test:city-urban": "node tests/city-urban-regression.mjs",
    "bake:nyc:roads": "node scripts/bake-nyc-world-data.mjs",
    "test:nyc-road-data": "node tests/nyc-road-data-bake-regression.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.187.0",
    "3d-tiles-renderer": "^0.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/three": "^0.187.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}