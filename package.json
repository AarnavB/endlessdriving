{
  "name": "endless-driving",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "npm run bake:nyc:world && vite --host 0.0.0.0",
    "build": "npm run bake:nyc:world && npm run build:app",
    "preview": "vite preview --host 0.0.0.0",
    "test:drivetrain": "node tests/drivetrain-regression.mjs",
    "test:nyc-geo": "node tests/nyc-geo-regression.mjs",
    "test:world": "npm run test:nyc-geo && npm run test:city-urban && npm run test:city-routing && npm run test:nyc-road-data && npm run test:nyc-road-graph && npm run test:nyc-building-geometry && npm run test:nyc-terrain-sampling && npm run test:nyc-terrain && npm run test:nyc-runtime",
    "test:city-routing": "node tests/city-routing-regression.mjs",
    "test:city-urban": "node tests/city-urban-regression.mjs",
    "bake:nyc:roads": "node scripts/bake-nyc-world-data.mjs",
    "test:nyc-road-data": "node tests/nyc-road-data-bake-regression.mjs",
    "test:nyc-road-graph": "node tests/nyc-road-graph-bake-regression.mjs",
    "build:app": "tsc --noEmit && vite build",
    "test:nyc-runtime": "node tests/nyc-runtime-gis-regression.mjs",
    "bake:nyc:buildings": "node scripts/bake-nyc-building-data.mjs",
    "bake:nyc:terrain": "node scripts/bake-nyc-terrain-data.mjs",
    "test:nyc-terrain": "node tests/nyc-terrain-regression.mjs",
    "bake:nyc:world": "npm run bake:nyc:roads && npm run bake:nyc:buildings && npm run bake:nyc:terrain",
    "test:nyc-terrain-sampling": "node tests/nyc-terrain-sampling-regression.mjs",
    "test:nyc-building-geometry": "node tests/nyc-building-geometry-regression.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.187.0",
    "3d-tiles-renderer": "^0.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/three": "^0.187.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
